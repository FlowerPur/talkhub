@{
    ViewData["Title"] = "Home Page";
}

<div class="auth-card">

<h2 id="login-heading">Вход</h2>
<form id="auth-form" class="auth-form">
    <input id="login" name="login" type="text" placeholder="Логин или почта" />
    <input id="password" name="password" type="password" placeholder="Пароль" />
    <span id="error-message"></span>
    <button id="login-button" class="login-button" type="submit">Войти</button>
</form>
<a href="#" id="register-link" class="register-link">Нет аккаунта?</a>
</div>