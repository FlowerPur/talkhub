@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="feed-container">
    <form class="feed-form">
        <textarea class="feed-input" placeholder="О чем думаешь?" rows="3"></textarea>
        <button class="feed-button" type="submit">Опубликовать</button>
    </form>
    <div class="post-card">
        <div class="post-header">
            <img src="[https://ui-avatars.com/api/?name=Ivan+Ivanov&background=007bff&color=fff](https://ui-avatars.com/api/?name=Ivan+Ivanov&background=007bff&color=fff)" alt="Аватар" class="post-avatar" />
            <a href="#" class="post-author">Иван Иванов</a>
            <span class="post-timestamp">2 часа назад</span>
        </div>
        <p class="post-text">
            Здарова уебки! Это мой первый поооост!!!</p>
        <div class="post-footer">
            <button class="like-button">❤️ 12</button>
            <button class="comments-button">💬 4</button>
        </div>
    </div>

    <button class="load-more-button">Загрузить еще</button>

</div>