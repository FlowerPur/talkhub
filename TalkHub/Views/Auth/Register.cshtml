@model RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" />
}

<span id="card-title">Register</span>

<form asp-controller="Auth" asp-action="Register" method="post">
    <input type="text" placeholder="Логин" asp-for="Login" />
    <span asp-validation-for="Password"></span>

    <input type="text" placeholder="Email" asp-for="Email" />
    <span asp-validation-for="Email"></span>

    <input type="password" placeholder="Пароль" asp-for="Password" />
    <span asp-validation-for="Password"></span>

    <button class="cta-button" type="submit">Зарегистрироваться</button>
</form>

<a asp-controller="Auth" asp-action="Login">Already have an account?</a>
